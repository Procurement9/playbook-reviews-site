# Documentation only: scripts do not automatically load this file.
# In GitHub Actions, store NVIDIA_API_KEY as a repository secret, not a variable.
# Do not put a real key in this example file.
NVIDIA_API_KEY=

# Optional non-secret model setting. GitHub repository variable: NVIDIA_MODEL.
# This is the configured default; inference access still requires a valid key.
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Optional manual-drafting settings. These are not required by current workflows.
# Built-in Manus credentials are runtime-provided; do not copy them to GitHub.
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --drive uses the pre-authorized gws CLI in the execution environment.
# No Google Drive credential is provisioned in GitHub Actions by this file.
